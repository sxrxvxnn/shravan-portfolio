{"parentUuid":"4dd8c740-cedd-47aa-b3f1-3be4f99ed0c0","isSidechain":false,"message":{"model":"claude-sonnet-4-6","id":"msg_011CdU4Qz8U2dyefpYnc7d74","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CGWGcZUppqrGzt5Cf5Zzep","name":"Write","input":{"file_path":"/Volumes/007/Dev/sxrxvxnn-portfolio/components/TimelineSection.tsx","content":"\"use client\";\n\nconst EXP = [\n  {\n    company:\"Technopark Leadgen\", role:\"Lead Engineer\", period:\"2025 — Present\",\n    color:\"#FF5252\", tags:[\"Python\",\"FastAPI\",\"Supabase\"],\n    bullets:[\n      \"Built full-stack B2B lead enrichment platform for Technopark startups\",\n      \"Integrated Hunter, Apollo, PDL APIs with real-time enrichment pipeline\",\n      \"Playwright scraping pipeline with SQS worker queue for concurrent execution\",\n    ],\n  },\n  {\n    company:\"Freelance\", role:\"Full-Stack Developer\", period:\"2024 — 2025\",\n    color:\"#9C27B0\", tags:[\"Next.js\",\"Chrome Extension\",\"Python\"],\n    bullets:[\n      \"Built Chrome extensions for LinkedIn profile enrichment (Sonar)\",\n      \"Delivered SaaS dashboards with real-time data pipelines for clients\",\n      \"Lookalike company search engine using Groq + PDL (sub-2s response)\",\n    ],\n  },\n  {\n    company:\"Personal Projects\", role:\"Python & AI Developer\", period:\"2023 — 2024\",\n    color:\"#00BCD4\", tags:[\"Python\",\"Playwright\",\"AI\"],\n    bullets:[\n      \"Automated LinkedIn outreach with Playwright scraping pipeline\",\n      \"Built industry/SaaS classification system using Groq LLM\",\n      \"Decision-maker verification pipeline with Playwright + API export\",\n    ],\n  },\n];\n\nexport default function TimelineSection() {\n  return (\n    <section id=\"experience\" style={{ marginBottom:56 }}>\n      <p style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"0.45rem\", color:\"var(--color-muted)\", marginBottom:24, letterSpacing:\"0.1em\" }}>// MY CAREER SO FAR</p>\n\n      <div className=\"flex flex-col gap-5\">\n        {EXP.map((exp, i) => (\n          <div key={i} className=\"p-5 sm:p-6\"\n            style={{ background:\"var(--color-surface)\", border:`2px solid ${exp.color}`, boxShadow:`4px 4px 0 ${exp.color}50`, transition:\"transform 0.15s,box-shadow 0.15s\" }}\n            onMouseEnter={e=>{(e.currentTarget as HTMLElement).style.transform=\"translate(-2px,-2px)\";(e.currentTarget as HTMLElement).style.boxShadow=`6px 6px 0 ${exp.color}60`;}}\n            onMouseLeave={e=>{(e.currentTarget as HTMLElement).style.transform=\"none\";(e.currentTarget as HTMLElement).style.boxShadow=`4px 4px 0 ${exp.color}50`;}}\n          >\n            <div className=\"flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-4\">\n              <div>\n                <p style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"0.62rem\", color:\"#1A1A2E\", marginBottom:5 }}>{exp.company}</p>\n                <p style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"0.48rem\", color:exp.color }}>{exp.role}</p>\n              </div>\n              <span style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"0.38rem\", color:\"var(--color-muted)\", whiteSpace:\"nowrap\" }}>{exp.period}</span>\n            </div>\n\n            <ul className=\"flex flex-col gap-2 mb-4\">\n              {exp.bullets.map((b,j) => (\n                <li key={j} style={{ fontSize:\"0.82rem\", color:\"var(--color-muted)\", lineHeight:1.65, paddingLeft:12, borderLeft:`3px solid ${exp.color}` }}>{b}</li>\n              ))}\n            </ul>\n\n            <div className=\"flex flex-wrap gap-2\">\n              {exp.tags.map(t => (\n                <span key={t} style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"0.38rem\", padding:\"4px 10px\", border:`1px solid ${exp.color}`, color:exp.color, background:`${exp.color}10` }}>{t}</span>\n              ))}\n            </div>\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n}\n"},"caller":{"type":"direct"}}],"