9C27B0\" },\n  { x:895, h:200, w:44, c:\"#E91E63\" },\n  { x:955, h:260, w:52, c:\"#00BCD4\" },\n  { x:1025,h:180, w:40, c:\"#7BE800\" },\n  { x:1082,h:310, w:60, c:\"#FF5252\" },\n  { x:1160,h:220, w:48, c:\"#FFC107\" },\n  { x:1225,h:280, w:56, c:\"#9C27B0\" },\n  { x:1300,h:160, w:36, c:\"#00BCD4\" },\n  { x:1355,h:340, w:60, c:\"#E91E63\" },\n];\n\nfunction PixelCloud({ x, y, scale }: { x:number; y:number; scale:number }) {\n  const w = Math.round(48 * scale);\n  const h = Math.round(20 * scale);\n  return (\n    <g transform={`translate(${x},${y})`}>\n      <rect x={Math.round(w*0.2)} y={Math.round(h*0.4)} width={Math.round(w*0.6)} height={Math.round(h*0.6)} fill=\"rgba(255,255,255,0.85)\" />\n      <rect x={0}              y={Math.round(h*0.6)} width={w}               height={Math.round(h*0.4)} fill=\"rgba(255,255,255,0.85)\" />\n      <rect x={Math.round(w*0.1)} y={Math.round(h*0.2)} width={Math.round(w*0.35)} height={Math.round(h*0.4)} fill=\"rgba(255,255,255,0.85)\" />\n      <rect x={Math.round(w*0.5)} y={Math.round(h*0.3)} width={Math.round(w*0.3)} height={Math.round(h*0.3)} fill=\"rgba(255,255,255,0.85)\" />\n    </g>\n  );\n}\n\nexport default function Hero() {\n  const [titleIdx, setTitleIdx] = useState(0);\n  const [displayed, setDisplayed] = useState(\"\");\n  const [typing, setTyping] = useState(true);\n  const avatarRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    const target = TITLES[titleIdx];\n    if (typing) {\n      if (displayed.length < target.length) {\n        const t = setTimeout(() => setDisplayed(target.slice(0, displayed.length + 1)), 65);\n        return () => clearTimeout(t);\n      } else {\n        const t = setTimeout(() => setTyping(false), 1800);\n        return () => clearTimeout(t);\n      }\n    } else {\n      if (displayed.length > 0) {\n        const t = setTimeout(() => setDisplayed(displayed.slice(0, -1)), 35);\n        return () => clearTimeout(t);\n      } else {\n        setTitleIdx(i => (i + 1) % TITLES.length);\n        setTyping(true);\n      }\n    }\n  }, [displayed, typing, titleIdx]);\n\n  useEffect(() => {\n    const el = avatarRef.current;\n    if (!el || window.matchMedia(\"(max-width:768px)\").matches) return;\n    el.style.transform = \"translate(-50%,-50%)\";\n    const move = (e: MouseEvent) => {\n      el.style.left = `${e.clientX + 16}px`;\n      el.style.top  = `${e.clientY + window.scrollY + 16}px`;\n    };\n    window.addEventListener(\"mousemove\", move);\n    return () => window.removeEventListener(\"mousemove\", move);\n  }, []);\n\n  return (\n    <section id=\"home\" className=\"relative scanlines overflow-hidden\" style={{ minHeight: \"100dvh\", display: \"flex\", flexDirection: \"column\" }}>\n\n      {/* Sky gradient */}\n      <div className=\"absolute inset-0\" style={{ background: \"linear-gradient(180deg,#87CEEB 0%,#B0E0FF 35%,#D4F0FF 60%,#E8F8FF 78%,#F0F8D0 100%)\", zIndex: 0 }} />\n\n      {/* Coloured stars / sparkles in sky */}\n      <div className=\"absolute inset-0\" style={{ zIndex: 1, pointerEvents:\"none\" }}>\n        {STARS.map((s,i) => (\n          <span key={i} style={{\n            position:\"absolute\", left:s.left, top:s.top,\n            width:s.size, height:s.size, borderRadius:\"50%\",\n            background:s.color, opacity:0.7,\n            animation:`twinkle ${s.dur} ${s.delay} infinite`,\n          }}/>\n        ))}\n      </div>\n\n      {/* SVG scene */}\n      <div className=\"absolute inset-0\" style={{ zIndex: 2 }}>\n        <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 1440 900\" preserveAspectRatio=\"xMidYMid slice\" style={{ position:\"absolute\", bottom:0, left:0 }}>\n\n          {/* Pixel clouds */}\n          {CLOUDS.map((c,i) => <PixelCloud key={i} {...c} />)}\n\n          {/* Back buildings (smaller, lighter) */}\n          {BUILDINGS.map((b,i) => (\n            <rect key={`b${i}`}\n              x={b.x} y={690 - b.h * 0.55} width={b.w * 0.7} height={b.h * 0.55}\n              fill={`${b.c}55`} />\n          ))}\n\n          {/* Main buildings */}\n          {BUILDINGS.map((b,i) => (\n            <g key={`m${i}`}>\n              <rect x={b.x} y={690 - b.h} width={b.w} height={b.h} fill={b.c} />\n              {/* Pixel outline / shadow */}\n              <rect x={b.x+b.w} y={690 - b.h + 4} width={4} height={b.h} fill=\"rgba(0,0,0,0.18)\" />\n              <rect x={b.x} y={690} width={b.w} height={4} fill=\"rgba(0,0,0,0.12)\" />\n              {/* Windows */}\n              {Array.from({ length: Math.floor(b.h / 40) }, (_, r) =>\n                Array.from({ length: Math.floor(b.w / 16) }, (_, c) => (\n                  <rect key={`${i}-${r}-${c}`}\n                    x={b.x + 4 + c * 16} y={690 - b.h + 16 + r * 36}\n                    width={8} height={10}\n                    fill=\"rgba(255,255,255,0.75)\"\n                    style={{ animation: `blink ${2 + ((i+r+c) % 4) * 0.6}s ${(i+r+c) * 0.25}s infinite` }}\n                  />\n                ))\n              )}\n            </g>\n          ))}\n\n          {/* Ground */}\n          <rect x=\"0\" y=\"690\" width=\"1440\" height=\"12\" fill=\"#7BE800\" />\n          <rect x=\"0\" y=\"702\" width=\"1440\" height=\"6\"  fill=\"#5CB800\" />\n          <rect x=\"0\" y=\"708\" width=\"1440\" height=\"192\" fill=\"#C8A96E\" />\n\n          {/* Pixel ground details */}\n          {Array.from({length:36},(_,i)=>(\n            <rect key={`g${i}`} x={i*40} y={702} width={12} height={6} fill=\"#4AA000\" />\n          ))}\n        </svg>\n      </div>\n\n      {/* Top gradient to keep nav readable */}\n      <div className=\"absolute inset-x-0 top-0\" style={{ height:100, background:\"linear-gradient(to bottom,rgba(135,206,235,0.7) 0%,transparent 100%)\", zIndex:3, pointerEvents:\"none\" }}/>\n\n      {/* Hero text */}\n      <div className=\"relative flex-1 flex flex-col justify-center px-6 sm:px-12\" style={{ zIndex:5, paddingTop:80, paddingBottom:200 }}>\n\n        <p style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"0.55rem\", color:\"#1A1A2E\", letterSpacing:\"0.15em\", marginBottom:16, textShadow:\"1px 1px 0 rgba(255,255,255,0.8)\" }}>\n          &gt; HELLO, I&apos;M\n        </p>\n\n        <h1 className=\"pixel-shadow\" style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"clamp(1.2rem,3.5vw,2.6rem)\", color:\"#1A1A2E\", lineHeight:1.5, marginBottom:16 }}>\n          Shravan{\" \"}\n          <span style={{ color:\"#9C27B0\", WebkitTextStroke:\"1px rgba(0,0,0,0.1)\" }}>&quot;Sxrxvxnn&quot;</span>\n          {\" \"}Omanakuttan\n        </h1>\n\n        <p style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"clamp(0.5rem,1.1vw,0.75rem)\", color:\"#1A1A2E\", marginBottom:8, textShadow:\"1px 1px 0 rgba(255,255,255,0.6)\" }}>\n          &gt; I am a{\" \"}\n          <span style={{ color:\"#E91E63\", background:\"rgba(233,30,99,0.12)\", padding:\"2px 6px\" }}>\n            {displayed}\n            <span style={{ animation:\"blink 1s infinite\", borderRight:\"2px solid #E91E63\" }}>&nbsp;</span>\n          </span>\n        </p>\n\n        <p style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"0.48rem\", color:\"#444\", marginTop:10, textShadow:\"1px 1px 0 rgba(255,255,255,0.6)\" }}>\n          based in Trivandrum, India\n        </p>\n\n        <a href=\"#about\" className=\"hidden sm:flex items-center gap-3 mt-10\" style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"0.48rem\", color:\"#333\" }}>\n          Scroll down\n          <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" style={{ animation:\"bounce 1.4s infinite\" }}>\n            <path d=\"M19 9l-7 7-7-7\"/>\n          </svg>\n        </a>\n      </div>\n\n      {/* Floating pixel robot */}\n      <div ref={avatarRef} className=\"hidden sm:block\" style={{ position:\"absolute\", left:0, top:0, zIndex:10, pointerEvents:\"none\", willChange:\"left,top\" }}>\n        <svg width=\"44\" height=\"48\" viewBox=\"0 0 44 48\">\n          {/* Head */}\n          <rect x=\"8\"  y=\"2\"  width=\"28\" height=\"22\" fill=\"#1A1A2E\" rx=\"2\"/>\n          <rect x=\"10\" y=\"4\"  width=\"24\" height=\"18\" fill=\"#2D2D4E\"/>\n          {/* Eyes */}\n          <rect x=\"13\" y=\"8\"  width=\"7\" height=\"7\"  fill=\"#7BE800\" style={{animation:\"blink 2.2s 0.3s infinite\"}}/>\n          <rect x=\"24\" y=\"8\"  width=\"7\" height=\"7\"  fill=\"#7BE800\" style={{animation:\"blink 2.2s 1.1s infinite\"}}/>\n          {/* Antenna */}\n          <rect x=\"19\" y=\"0\"  width=\"6\" height=\"2\"  fill=\"#FF5252\"/>\n          <rect x=\"21\" y=\"-5\" width=\"2\" height=\"5\"  fill=\"#FF5252\"/>\n          <rect x=\"19\" y=\"-7\" width=\"6\" height=\"2\"  fill=\"#FF5252\"/>\n          <rect x=\"20\" y=\"-8\" width=\"4\" height=\"2\"  fill=\"#FFD700\"/>\n          {/* Body */}\n          <rect x=\"4\"  y=\"26\" width=\"36\" height=\"18\" fill=\"#1A1A2E\" rx=\"2\"/>\n          <rect x=\"6\"  y=\"28\" width=\"32\" height=\"14\" fill=\"#2D2D4E\"/>\n          {/* Arms */}\n          <rect x=\"0\"  y=\"27\" width=\"4\"  height=\"12\" fill=\"#1A1A2E\"/>\n          <rect x=\"40\" y=\"27\" width=\"4\"  height=\"12\" fill=\"#1A1A2E\"/>\n          {/* Legs */}\n          <rect x=\"9\"  y=\"44\" width=\"10\" height=\"4\" fill=\"#1A1A2E\"/>\n          <rect x=\"25\" y=\"44\" width=\"10\" height=\"4\" fill=\"#1A1A2E\"/>\n          {/* Chest LED */}\n          <rect x=\"15\" y=\"30\" width=\"14\" height=\"8\" fill=\"#00BCD4\" opacity=\"0.4\"/>\n          <rect x=\"19\" y=\"32\" width=\"6\"  height=\"4\" fill=\"#00BCD4\"/>\n        </svg>\n      </div>\n\n      {/* Bottom taskbar */}\n      <div className=\"relative\" style={{ zIndex:6, borderTop:\"3px solid #1A1A2E\", background:\"rgba(247,243,236,0.95)\", backdropFilter:\"blur(4px)\" }}>\n        <div className=\"flex items-center justify-between px-4 sm:px-8\" style={{ height:52 }}>\n          <a href=\"/resume.pdf\" className=\"btn-ghost\" style={{ fontSize:\"0.42rem\", padding:\"5px 12px\" }}>▶ Resume</a>\n\n          <div className=\"flex items-center gap-3\">\n            {[\n              { label:\"GH\", color:\"#1A1A2E\", href:\"https://github.com/sxrxvxnn\" },\n              { label:\"LI\", color:\"#0077B5\", href:\"https://linkedin.com/in/shravan-omanakuttan\" },\n              { label:\"TW\", color:\"#1DA1F2\", href:\"https://twitter.com/sxrxvxnn\" },\n            ].map(s => (\n              <a key={s.label} href={s.href} target=\"_blank\" rel=\"noopener noreferrer\"\n                style={{ width:32, height:32, border:`2px solid ${s.color}`, display:\"flex\", alignItems:\"center\", justifyContent:\"center\", fontFamily:\"var(--font-pixel)\", fontSize:\"0.38rem\", color:s.color, background:\"transparent\", transition:\"background 0.15s\" }}\n                onMouseEnter={e=>(e.currentTarget.style.background=`${s.color}18`)}\n                onMouseLeave={e=>(e.currentTarget.style.background=\"transparent\")}\n              >{s.label}</a>\n            ))}\n          </div>\n\n          <a href=\"mailto:aathmaj.riyadh@gmail.com\" style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"0.38rem\", color:\"var(--color-muted)\", transition:\"color 0.2s\" }}\n            onMouseEnter={e=>(e.currentTarget.style.color=\"#E91E63\")}\n            onMouseLeave={e=>(e.currentTarget.style.color=\"var(--color-muted)\")}\n          >✉ aathmaj.riyadh@gmail.com</a>\n        </div>\n      </div>\n\n      <style>{`@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}`}</style>\n    </section>\n  );\n}\n","structuredPatch":[{"oldStart":8,"oldLines":26,"newStart":8,"newLines":74,"lines":["   \"Product Engineer\","," ];"," ","-const STARS = Array.from({ length: 60 }, (_, i) => ({","+const STARS = Array.from({ length: 30 }, (_, i) => ({","   left: `${(i * 37.3) % 100}%`,","-  top: `${(i * 61.8) % 70}%`,","-  size: i % 3 === 0 ? 2 : 1,","-  dur: `${2 + (i % 4) * 0.7}s`,","-  delay: `${(i * 0.23) % 3}s`,","+  top: `${(i * 31.8) % 55}%`,","+  size: i % 3 === 0 ? 3 : 2,","+  dur: `${2.5 + (i % 3) * 0.8}s`,","+  delay: `${(i * 0.3) % 2.5}s`,","+  color: [\"#FFD700\",\"#FF5252\",\"#7BE800\",\"#00BCD4\",\"#9C27B0\",\"#E91E63\"][i % 6],"," }));"," ","+/* Pixel clouds */","+const CLOUDS = [","+  { x: 80,  y: 60,  scale: 1.2 },","+  { x: 320, y: 40,  scale: 0.8 },","+  { x: 600, y: 70,  scale: 1.0 },","+  { x: 900, y: 50,  scale: 1.4 },","+  { x: 1150,y: 65,  scale: 0.9 },","+  { x: 1350,y: 45,  scale: 1.1 },","+];","+","+/* Pixel buildings - colour index per building */","+const BUILDINGS = [","+  { x:40,  h:220, w:44, c:\"#FF5252\" },","+  { x:100, h:300, w:56, c:\"#9C27B0\" },","+  { x:175, h:170, w:36, c:\"#00BCD4\" },","+  { x:230, h:340, w:52, c:\"#FF5252\" },","+  { x:300, h:250, w:48, c:\"#7BE800\" },","+  { x:365, h:190, w:40, c:\"#FFC107\" },","+  { x:420, h:280, w:56, c:\"#E91E63\" },","+  { x:490, h:160, w:36, c:\"#9C27B0\" },","+  { x:545, h:320, w:64, c:\"#00BCD4\" },","+  { x:625, h:230, w:48, c:\"#7BE800\" },","+  { x:690, h:270, w:56, c:\"#FF5252\" },","+  { x:760, h:190, w:40, c:\"#FFC107\" },","+  { x:815, h:350, w:64, c:\"#9C27B0\" },","+  { x:895, h:200, w:44, c:\"#E91E63\" },","+  { x:955, h:260, w:52, c:\"#00BCD4\" },","+  { x:1025,h:180, w:40, c:\"#7BE800\" },","+  { x:1082,h:310, w:60, c:\"#FF5252\" },","+  { x:1160,h:220, w:48, c:\"#FFC107\" },","+  { x:1225,h:280, w:56, c:\"#9C27B0\" },","+  { x:1300,h:160, w:36, c:\"#00BCD4\" },","+  { x:1355,h:340, w:60, c:\"#E91E63\" },","+];","+","+function PixelCloud({ x, y, scale }: { x:number; y:number; scale:number }) {","+  const w = Math.round(48 * scale);","+  const h = Math.round(20 * scale);","+  return (","+    <g transform={`translate(${x},${y})`}>","+      <rect x={Math.round(w*0.2)} y={Math.round(h*0.4)} width={Math.round(w*0.6)} height={Math.round(h*0.6)} fill=\"rgba(255,255,255,0.85)\" />","+      <rect x={0}              y={Math.round(h*0.6)} width={w}               height={Math.round(h*0.4)} fill=\"rgba(255,255,255,0.85)\" />","+      <rect x={Math.round(w*0.1)} y={Math.round(h*0.2)} width={Math.round(w*0.35)} height={Math.round(h*0.4)} fill=\"rgba(255,255,255,0.85)\" />","+      <rect x={Math.round(w*0.5)} y={Math.round(h*0.3)} width={Math.round(w*0.3)} height={Math.round(h*0.3)} fill=\"rgba(255,255,255,0.85)\" />","+    </g>","+  );","+}","+"," export default function Hero() {","   const [titleIdx, setTitleIdx] = useState(0);","   const [displayed, setDisplayed] = useState(\"\");","   const [typing, setTyping] = useState(true);","   const avatarRef = useRef<HTMLDivElement>(null);"," ","-  /* Typing animation */","   useEffect(() => {","     const target = TITLES[titleIdx];","     if (typing) {","       if (displayed.length < target.length) {","-        const t = setTimeout(() => setDisplayed(target.slice(0, displayed.length + 1)), 70);","+        const t = setTimeout(() => setDisplayed(target.slice(0, displayed.length + 1)), 65);","         return () => clearTimeout(t);","       } else {","         const t = setTimeout(() => setTyping(false), 1800);"]},{"oldStart":35,"oldLines":360,"newStart":83,"newLines":184,"lines":["       }","     } else {","       if (displayed.length > 0) {","-        const t = setTimeout(() => setDisplayed(displayed.slice(0, -1)), 40);","+        const t = setTimeout(() => setDisplayed(displayed.slice(0, -1)), 35);","         return () => clearTimeout(t);","       } else {","-        setTitleIdx((i) => (i + 1) % TITLES.length);","+        setTitleIdx(i => (i + 1) % TITLES.length);","         setTyping(true);","       }","     }","   }, [displayed, typing, titleIdx]);"," ","-  /* Floating avatar follows cursor */","   useEffect(() => {","     const el = avatarRef.current;","     if (!el || window.matchMedia(\"(max-width:768px)\").matches) return;","     el.style.transform = \"translate(-50%,-50%)\";","     const move = (e: MouseEvent) => {","-      el.style.left = `${e.clientX + 14}px`;","-      el.style.top  = `${e.clientY + window.scrollY + 14}px`;","+      