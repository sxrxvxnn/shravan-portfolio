er\", transition:\"all 0.15s\",","+              boxShadow: active === g.id ? `2px 2px 0 ${g.color}60` : \"none\",","             }}","-          >","-            {g.label}","-          </button>","+          >{g.label}</button>","         ))}","       </div>"," ","-      {/* Tag cloud */}","       <div className=\"flex flex-wrap gap-2\">","-        {displayed.map((item) => (","-          <span key={item} className=\"tag\">","-            {item}","-          </span>","-        ))}","+        {displayed.map((item, i) => {","+          const tc = TAG_COLORS[i % TAG_COLORS.length];","+          return (","+            <span key={item} style={{","+              fontFamily:\"var(--font-pixel)\", fontSize:\"0.4rem\", padding:\"5px 10px\",","+              background:tc.bg, border:`1px solid ${tc.border}`, color:tc.text,","+              display:\"inline-flex\", alignItems:\"center\",","+            }}>{item}</span>","+          );","+        })}","       </div>","     </section>","   );"]}],"originalFile":"\"use client\";\nimport { useState } from \"react\";\n\nconst groups = [\n  {\n    id: \"all\",\n    label: \"All\",\n    items: [] as string[],\n  },\n  {\n    id: \"ai\",\n    label: \"AI & Data\",\n    items: [\"Python\", \"Groq\", \"OpenAI\", \"PDL API\", \"Hunter.io\", \"Apollo.io\", \"Firecrawl\"],\n  },\n  {\n    id: \"backend\",\n    label: \"Backend\",\n    items: [\"FastAPI\", \"PostgreSQL\", \"Supabase\", \"Redis\", \"Docker\", \"SQS\", \"REST APIs\"],\n  },\n  {\n    id: \"frontend\",\n    label: \"Frontend\",\n    items: [\"Next.js\", \"React\", \"TypeScript\", \"Tailwind\", \"GSAP\", \"Lenis\"],\n  },\n  {\n    id: \"tools\",\n    label: \"Tools\",\n    items: [\"Playwright\", \"Git\", \"Vercel\", \"Linux\", \"VSCode\", \"Postman\"],\n  },\n];\n\nconst allItems = groups.slice(1).flatMap((g) => g.items);\n\nexport default function ArsenalSection() {\n  const [active, setActive] = useState(\"all\");\n\n  const displayed =\n    active === \"all\"\n      ? allItems\n      : groups.find((g) => g.id === active)?.items ?? [];\n\n  return (\n    <section style={{ marginBottom: 64 }}>\n      <p\n        style={{\n          fontFamily: \"var(--font-pixel)\",\n          fontSize: \"0.5rem\",\n          color: \"var(--color-muted)\",\n          marginBottom: 16,\n          letterSpacing: \"0.1em\",\n        }}\n      >\n        // TECH ARSENAL\n      </p>\n\n      {/* Filter tabs */}\n      <div className=\"flex flex-wrap gap-2 mb-6\">\n        {groups.map((g) => (\n          <button\n            key={g.id}\n            onClick={() => setActive(g.id)}\n            style={{\n              fontFamily: \"var(--font-pixel)\",\n              fontSize: \"0.4rem\",\n              padding: \"6px 12px\",\n              border: `1px solid ${active === g.id ? \"var(--color-accent)\" : \"var(--color-borderfaint)\"}`,\n              background: active === g.id ? \"rgba(200,255,0,0.1)\" : \"transparent\",\n              color: active === g.id ? \"var(--color-accent)\" : \"var(--color-muted)\",\n              cursor: \"pointer\",\n              transition: \"all 0.2s\",\n            }}\n          >\n            {g.label}\n          </button>\n        ))}\n      </div>\n\n      {/* Tag cloud */}\n      <div className=\"flex flex-wrap gap-2\">\n        {displayed.map((item) => (\n          <span key={item} className=\"tag\">\n            {item}\n          </span>\n        ))}\n      </div>\n    </section>\n  );\n}\n","userModified":false},"sourceToolAssistantUUID":"27a06cf8-67b8-45c4-8192-e5269d9304b9","userType":"external","entrypoint":"cli","cwd":"/Volumes/007/Dev/sxrxvxnn-portfolio","sessionId":"766ea352-bd52-4004-9921-a57046893916","version":"2.1.177","gitBranch":"worktree/calm-forest-b499","slug":"jaunty-forging-scroll"}
