anslate(-2px,-2px); box-shadow: 3px 3px 0 rgba(0,0,0,0.3); }"," ","-/* Ghost button */"," .btn-ghost {","   font-family: var(--font-pixel);","-  font-size: 0.5rem;","+  font-size: 0.45rem;","   padding: 8px 16px;","-  border: 1px solid var(--color-accent);","-  color: var(--color-accent);","+  border: 2px solid var(--color-ink);","+  color: var(--color-ink);","   background: transparent;","   cursor: pointer;","-  transition: background 0.2s, box-shadow 0.2s;","+  display: inline-flex;","+  align-items: center;","+  gap: 6px;","+  transition: background 0.15s, transform 0.1s;"," }","-.btn-ghost:hover {","-  background: rgba(200,255,0,0.1);","-  box-shadow: 0 0 12px rgba(200,255,0,0.3);","-}","+.btn-ghost:hover { background: rgba(26,26,46,0.06); transform: translate(-1px,-1px); }"]}],"originalFile":"@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Share+Tech+Mono&display=swap');\n@import \"tailwindcss\";\n\n@theme {\n  --color-bg:        #070B14;\n  --color-surface:   #0D1526;\n  --color-surface2:  #111D33;\n  --color-ink:       #E2EDF8;\n  --color-muted:     #4E6880;\n  --color-accent:    #C8FF00;\n  --color-accent2:   #00FFB2;\n  --color-border:    rgba(200,255,0,0.18);\n  --color-borderfaint: rgba(200,255,0,0.07);\n\n  --font-pixel: 'Press Start 2P', monospace;\n  --font-mono:  'Share Tech Mono', 'Courier New', monospace;\n  --font-sans:  var(--font-geist-sans), system-ui, sans-serif;\n}\n\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\nhtml {\n  scroll-behavior: smooth;\n  -webkit-font-smoothing: antialiased;\n}\n\nbody {\n  background: var(--color-bg);\n  color: var(--color-ink);\n  font-family: var(--font-mono);\n  overflow-x: hidden;\n  cursor: crosshair;\n}\n\n::selection {\n  background: var(--color-accent);\n  color: #000;\n}\n\na { color: inherit; text-decoration: none; }\nimg { display: block; max-width: 100%; }\n\n/* Pixel shadow utility */\n.pixel-shadow { text-shadow: 2px 2px 0 #000, -1px -1px 0 #000; }\n.pixel-glow   { text-shadow: 0 0 8px var(--color-accent), 0 0 24px rgba(200,255,0,0.4); }\n\n/* Scrollbar */\n::-webkit-scrollbar       { width: 4px; }\n::-webkit-scrollbar-track { background: var(--color-bg); }\n::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 2px; }\n\n/* Blinking cursor keyframe */\n@keyframes blink {\n  0%, 100% { opacity: 1; }\n  50%       { opacity: 0; }\n}\n\n/* Star twinkle */\n@keyframes twinkle {\n  0%, 100% { opacity: 0.3; transform: scale(1); }\n  50%       { opacity: 1; transform: scale(1.4); }\n}\n\n/* Scan line overlay */\n.scanlines::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: repeating-linear-gradient(\n    0deg,\n    transparent,\n    transparent 2px,\n    rgba(0,0,0,0.15) 2px,\n    rgba(0,0,0,0.15) 4px\n  );\n  pointer-events: none;\n  z-index: 1;\n}\n\n/* Tag pill */\n.tag {\n  display: inline-flex;\n  align-items: center;\n  padding: 3px 10px;\n  border: 1px solid var(--color-border);\n  border-radius: 2px;\n  font-family: var(--font-pixel);\n  font-size: 0.45rem;\n  color: var(--color-accent);\n  letter-spacing: 0.05em;\n  background: rgba(200,255,0,0.05);\n}\n\n/* Accent button */\n.btn-accent {\n  font-family: var(--font-pixel);\n  font-size: 0.55rem;\n  padding: 10px 18px;\n  background: var(--color-accent);\n  color: #000;\n  border: none;\n  cursor: pointer;\n  transition: box-shadow 0.2s;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n.btn-accent:hover {\n  box-shadow: 0 0 16px rgba(200,255,0,0.6);\n}\n\n/* Ghost button */\n.btn-ghost {\n  font-family: var(--font-pixel);\n  font-size: 0.5rem;\n  padding: 8px 16px;\n  border: 1px solid var(--color-accent);\n  color: var(--color-accent);\n  background: transparent;\n  cursor: pointer;\n  transition: background 0.2s, box-shadow 0.2s;\n}\n.btn-ghost:hover {\n  background: rgba(200,255,0,0.1);\n  box-shadow: 0 0 12px rgba(200,255,0,0.3);\n}\n","userModified":false},"sourceToolAssistantUUID":"732da20f-533a-42ff-9adb-694bc00b4853","userType":"external","entrypoint":"cli","cwd":"/Volumes/007/Dev/sxrxvxnn-portfolio","sessionId":"766ea352-bd52-4004-9921-a57046893916","version":"2.1.177","gitBranch":"worktree/calm-forest-b499","slug":"jaunty-forging-scroll"}
