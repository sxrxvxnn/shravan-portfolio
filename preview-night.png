seEnter={e=>{ (e.currentTarget as HTMLElement).style.transform=\"translate(-2px,-2px)\"; (e.currentTarget as HTMLElement).style.boxShadow=`5px 5px 0 ${c.color}60`; }}","+            onMouseLeave={e=>{ (e.currentTarget as HTMLElement).style.transform=\"none\"; (e.currentTarget as HTMLElement).style.boxShadow=`3px 3px 0 ${c.color}40`; }}","           >","-            <p","-              style={{","-                fontFamily: \"var(--font-pixel)\",","-                fontSize: \"0.55rem\",","-                color: \"var(--color-accent)\",","-                marginBottom: 10,","-              }}","-            >","-              {c.icon} {c.title}","-            </p>","-            <p style={{ fontSize: \"0.82rem\", color: \"var(--color-muted)\", lineHeight: 1.65 }}>","-              {c.desc}","-            </p>","+            <p style={{ fontFamily:\"var(--font-pixel)\", fontSize:\"0.52rem\", color:c.color, marginBottom:10 }}>{c.icon} {c.title}</p>","+            <p style={{ fontSize:\"0.82rem\", color:\"var(--color-muted)\", lineHeight:1.65 }}>{c.desc}</p>","           </div>","         ))}","       </div>"]}],"originalFile":"\"use client\";\nimport Link from \"next/link\";\n\nconst capabilities = [\n  {\n    icon: \"⬡\",\n    title: \"AI Pipelines\",\n    desc: \"End-to-end enrichment pipelines using Groq, OpenAI, and PDL. Sub-2s from URL to classified company.\",\n  },\n  {\n    icon: \"⬡\",\n    title: \"Web Scraping\",\n    desc: \"Playwright-based scrapers for LinkedIn, company sites, G2. SQS queues for scale.\",\n  },\n  {\n    icon: \"⬡\",\n    title: \"Full-Stack\",\n    desc: \"FastAPI backends + Next.js frontends. PostgreSQL + Supabase. Real-time dashboards.\",\n  },\n  {\n    icon: \"⬡\",\n    title: \"Chrome Extensions\",\n    desc: \"Browser-native tools that enrich data without leaving the page. Used in active sales workflows.\",\n  },\n];\n\nexport default function AboutSection() {\n  return (\n    <section id=\"about\" style={{ marginBottom: 64 }}>\n      {/* About card */}\n      <div\n        className=\"flex flex-col sm:flex-row gap-6 mb-10 p-6\"\n        style={{\n          background: \"var(--color-surface)\",\n          border: \"1px solid var(--color-border)\",\n        }}\n      >\n        {/* Avatar / initials */}\n        <div\n          className=\"flex-shrink-0 flex items-center justify-center\"\n          style={{\n            width: 80, height: 80,\n            border: \"2px solid var(--color-accent)\",\n            background: \"rgba(200,255,0,0.06)\",\n            fontFamily: \"var(--font-pixel)\",\n            fontSize: \"1rem\",\n            color: \"var(--color-accent)\",\n            textShadow: \"0 0 8px rgba(200,255,0,0.5)\",\n          }}\n        >\n          S.O\n        </div>\n\n        <div className=\"flex flex-col gap-3\">\n          <p\n            style={{\n              fontFamily: \"var(--font-pixel)\",\n              fontSize: \"0.7rem\",\n              color: \"var(--color-accent)\",\n            }}\n          >\n            Building intelligence from data\n          </p>\n          <p style={{ fontSize: \"0.9rem\", lineHeight: 1.7, color: \"var(--color-ink)\", maxWidth: 560 }}>\n            I build AI-powered B2B systems — from company enrichment pipelines to LinkedIn scraping\n            at scale. Currently leading product and engineering for a Technopark lead generation platform.\n          </p>\n          <a\n            href=\"#contact\"\n            className=\"btn-ghost self-start mt-2\"\n          >\n            Get in touch &gt;\n          </a>\n        </div>\n      </div>\n\n      {/* What I do */}\n      <p\n        style={{\n          fontFamily: \"var(--font-pixel)\",\n          fontSize: \"0.5rem\",\n          color: \"var(--color-muted)\",\n          marginBottom: 16,\n          letterSpacing: \"0.1em\",\n        }}\n      >\n        // WHAT I DO\n      </p>\n\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        {capabilities.map((c) => (\n          <div\n            key={c.title}\n            className=\"p-5\"\n            style={{\n              background: \"var(--color-surface2)\",\n              border: \"1px solid var(--color-borderfaint)\",\n              transition: \"border-color 0.2s\",\n            }}\n            onMouseEnter={(e) => ((e.currentTarget as HTMLElement).style.borderColor = \"var(--color-border)\")}\n            onMouseLeave={(e) => ((e.currentTarget as HTMLElement).style.borderColor = \"var(--color-borderfaint)\")}\n          >\n            <p\n              style={{\n                fontFamily: \"var(--font-pixel)\",\n                fontSize: \"0.55rem\",\n                color: \"var(--color-accent)\",\n                marginBottom: 10,\n              }}\n            >\n              {c.icon} {c.title}\n            </p>\n            <p style={{ fontSize: \"0.82rem\", color: \"var(--color-muted)\", lineHeight: 1.65 }}>\n              {c.desc}\n            </p>\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n}\n","userModified":false},"sourceToolAssistantUUID":"1bfefc98-a435-41fa-92c9-bf2a475a3f3e","userType":"external","entrypoint":"cli","cwd":"/Volumes/007/Dev/sxrxvxnn-portfolio","sessionId":"766ea352-bd52-4004-9921-a57046893916","version":"2.1.177","gitBranch":"worktree/calm-forest-b499","slug":"jaunty-forging-scroll"}
